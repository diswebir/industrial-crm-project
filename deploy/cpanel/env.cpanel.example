APP_NAME="Parts CRM"
APP_ENV=production
APP_DEBUG=false
APP_KEY=__GENERATED_AT_BUILD__
APP_TIMEZONE=Asia/Tehran
APP_URL=https://YOUR-DOMAIN.ir

# Split deployment: in most cases you do NOT need this — install.php writes
# app-path.txt next to public/index.php automatically. Only set it if you
# want to override the private app path, e.g.:
# APP_BASE_PATH=/home/youruser/private_pro/project1/myc

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpuser_crmdb
DB_USERNAME=cpuser_crmuser
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_FROM=
MELIPAYAMAK_SANDBOX=true
