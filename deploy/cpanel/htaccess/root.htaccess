# =====================================================================
# ROOT .htaccess for single-folder mode (scenario B):
# when the whole app is extracted directly into public_html and the
# DocumentRoot cannot be changed.
#
# Replace the content of public_html/.htaccess with this file.
# (Stored with a .txt extension so Apache does not execute it.)
# =====================================================================

# ---- Block private files ----
<FilesMatch "^(app-path\.txt|\.env|\.env\..*|composer\.(json|lock)|artisan)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Forbid direct web access to private app folders (outside public/)
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/|$) - [F,L]

    # Route all requests into the Laravel public/ folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
